# Environment configuration for local development
# Copy this file to .env and update values as needed

# Database Configuration
DB_USERNAME=sahastra_user
DB_PASSWORD=sahastra_password

# Redis Configuration
REDIS_PASSWORD=

# OpenSearch Configuration
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# pgAdmin Configuration (optional)
PGADMIN_PASSWORD=

# Application Configuration
ENVIRONMENT=dev
APP_PORT=8080
JAVA_OPTS=-Xmx1024m -Xms512m

# Zoho Mail SMTP (use a Zoho app-specific password; never commit the actual value)
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=info@sahastradigital.com
MAIL_PASSWORD=
MAIL_FROM=info@sahastradigital.com
# Set to an address you control only when running ZohoMailConnectivityTest.
MAIL_TEST_TO=
EMAIL_VERIFICATION_URL=http://localhost:8080/api/v1/auth/verify-email

# Secret management note:
# Store production secrets in environment-specific vaults or AWS Secrets Manager.
